    {
      "parameters": {
        "jsCode": "const progress = $input.all().map(item => item.json);\nconst sessionId = $('When chat message received').first().json.sessionId;\n\nfunction getField(obj, targetName) {\n  const target = targetName.toLowerCase();\n  const key = Object.keys(obj).find(k => k.trim().toLowerCase() === target);\n  return key ? String(obj[key]).trim() : '';\n}\n\nconst inProgress = progress.find(item => {\n  const status = getField(item, 'статус').toLowerCase();\n  const rowSession = getField(item, 'сотрудник');\n  return rowSession === sessionId && status === 'в процессе';\n});\n\nif (!inProgress) {\n  return [{ json: { status: 'error', message: 'Нет активного стандарта' } }];\n}\n\nreturn [{\n  json: {\n    status: 'found',\n    rowNumber: inProgress.row_number,\n    standardId: inProgress['ID стандарта'],\n    sessionId: sessionId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        352
      ],
      "id": "1cf7ea2a-2a33-4a0a-afac-e21aac40f3e8",
      "name": "Code in JavaScript",
      "notesInFlow": true,
      "notes": "Ищет в листе «Прогресс» строку, где:\n— Сотрудник = sessionId из чата\n— Статус = «в процессе»\n\nИспользует getField() для поиска полей с учётом регистра и невидимых символов.\nВозвращает rowNumber для обновления в узле Update row in sheet.\nЕсли строка не найдена — возвращает status: 'error'."
    },
