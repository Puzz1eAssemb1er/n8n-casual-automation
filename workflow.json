    {
      "parameters": {
        "jsCode": "const standards = $('Get row(s) in sheet').all()\n  .map(item => item.json)\n  .filter(s => s && s.ID);\n\nconst progress = $input.all()\n  .map(item => item.json)\n  .filter(item => item && item['ID стандарта']);\n\nconst sessionId = $('When chat message received').first().json.sessionId;\n\nconst completedIds = progress\n  .filter(item => item['Сотрудник'] === sessionId)\n  .map(item => String(item['ID стандарта']));\n\nfunction cleanText(text) {\n  if (!text) return '';\n  return String(text)\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/?[^>]+(>|$)/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n}\n\nconst nextStandard = standards.find(s => !completedIds.includes(String(s.ID)));\n\nif (!nextStandard) {\n  return [{ json: { status: 'completed' } }];\n}\n\nreturn [{\n  json: {\n    status: 'next',\n    sessionId: sessionId,\n    standardId: nextStandard.ID,\n    name: cleanText(nextStandard['Название']),\n    description: cleanText(nextStandard['Описание']),\n    equipment: cleanText(nextStandard['Оборудование'])\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        144
      ],
      "id": "c1c29274-de99-4f35-ada7-45739c730d71",
      "name": "ветка «обучение»",
      "notesInFlow": true,
      "notes": "Сравнивает два списка:\n— все стандарты (из Get row(s) in sheet, лист «Стандарты»)\n— пройденные этим sessionId (из Get row(s) in sheet1, лист «Прогресс»)\n\nВозвращает первый непройденный стандарт со статусом 'next'.\nЕсли все пройдены — возвращает 'completed'.\nОчищает HTML-теги в name, description, equipment."
    },
