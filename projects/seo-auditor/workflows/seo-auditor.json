{
  "name": "SEO Auditor — n8n",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "manual-trigger",
      "name": "▶️ Запуск аудита",
      "notesInFlow": true,
      "notes": "Ручной старт"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "baseUrl",
              "value": "https://example.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [224, 0],
      "id": "target-url",
      "name": "🌐 Адрес сайта",
      "notesInFlow": true,
      "notes": "Хранит URL для проверки"
    },
    {
      "parameters": {
        "url": "={{ $json.baseUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "text" } },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [448, 0],
      "id": "homepage-request",
      "name": "📥 Скачать главную страницу",
      "notesInFlow": true,
      "notes": "Загружает HTML главной страницы"
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            { "key": "title", "cssSelector": "title" },
            { "key": "description", "cssSelector": "meta[name=\"description\"]", "returnValue": "attribute", "attribute": "content" },
            { "key": "h1", "cssSelector": "h1" },
            { "key": "links", "cssSelector": "a", "returnValue": "attribute", "attribute": "href", "returnArray": true }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [672, 0],
      "id": "extract-links",
      "name": "🔗 Собрать ссылки",
      "notesInFlow": true,
      "notes": "Извлекает ссылки и базовые SEO-поля"
    },
    {
      "parameters": { "fieldToSplitOut": "links", "options": {} },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [896, 0],
      "id": "split-links",
      "name": "📋 Разбить на список",
      "notesInFlow": true,
      "notes": "Превращает массив ссылок в отдельные элементы"
    },
    {
      "parameters": {
        "jsCode": "const baseUrl = $('🌐 Адрес сайта').first().json.baseUrl;\nreturn $input.all().filter(item => { const url = item.json.links || ''; return url.startsWith('/') || url.startsWith(baseUrl); });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 0],
      "id": "filter-links",
      "name": "🧹 Фильтр ссылок",
      "notesInFlow": true,
      "notes": "Оставляет внутренние ссылки"
    },
    {
      "parameters": { "compare": "selectedFields", "fieldsToCompare": "links", "options": {} },
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [1344, 0],
      "id": "dedupe",
      "name": "🔂 Убрать дубли",
      "notesInFlow": true,
      "notes": "Оставляет уникальные URL"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "full-url",
              "name": "fullUrl",
              "value": "={{ $json.links.startsWith('http') ? $json.links : $('🌐 Адрес сайта').first().json.baseUrl + $json.links }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1568, 0],
      "id": "normalize-url",
      "name": "🔧 Сделать полные адреса",
      "notesInFlow": true,
      "notes": "Добавляет домен к относительным ссылкам"
    },
    {
      "parameters": {
        "url": "={{ $json.fullUrl }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0 Safari/537.36" }] },
        "options": { "response": { "response": { "responseFormat": "text" } }, "timeout": 10000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1792, 0],
      "id": "crawl-pages",
      "name": "📥 Скачать все страницы",
      "onError": "continueErrorOutput",
      "notesInFlow": true,
      "notes": "Загружает обнаруженные внутренние страницы"
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "=json",
        "extractionValues": {
          "values": [
            { "key": "title", "cssSelector": "title" },
            { "key": "description", "cssSelector": "meta[name=\"description\"]", "returnValue": "attribute", "attribute": "content" },
            { "key": "h1", "cssSelector": "h1" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [2016, 0],
      "id": "extract-meta",
      "name": "🏷️ Извлечь мета-теги",
      "notesInFlow": true,
      "notes": "Собирает title, description и h1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet report = `SEO-АУДИТ САЙТА\\nВсего страниц: ${items.length}\\n\\n`;\nitems.forEach((item, index) => { const title = item.json.title || '[ОТСУТСТВУЕТ]'; const description = item.json.description || '[ОТСУТСТВУЕТ]'; const h1 = item.json.h1 || '[ОТСУТСТВУЕТ]'; report += `--- Страница ${index + 1} ---\\nTitle: ${title}\\nTitle длина: ${title.length} символов\\nDescription: ${description}\\nDescription длина: ${description.length} символов\\nH1: ${h1}\\n\\n`; });\nreturn [{ json: { report } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, 0],
      "id": "aggregate-report",
      "name": "📝 Собрать отчёт",
      "notesInFlow": true,
      "notes": "Формирует единый вход для AI-анализа"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.report }}",
        "messages": { "messageValues": [{ "message": "=Ты — опытный SEO-специалист. Проанализируй мета-теги страниц сайта. Укажи общую статистику, проблемы Title, Description и H1, включая отсутствующие, потенциально слишком короткие/длинные и дублирующиеся значения, затем дай конкретные рекомендации по исправлению. Форматируй результат структурированными заголовками и списками." }] },
        "batching": { "batchSize": 5 }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [2464, 0],
      "id": "claude-analysis",
      "name": "🤖 Анализ Claude AI",
      "notesInFlow": true,
      "notes": "Интерпретирует собранный SEO-набор"
    },
    {
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "claude-sonnet-5", "cachedResultName": "Claude Sonnet 5" },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [2464, 240],
      "id": "claude-model",
      "name": "🧠 Модель Claude",
      "notesInFlow": true,
      "notes": "Подключение модели Claude"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text || '';\nlet html = text.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>').replace(/^### (.+)$/gm, '<h4>$1</h4>').replace(/^## (.+)$/gm, '<h3>$1</h3>').replace(/^# (.+)$/gm, '<h2>$1</h2>').replace(/^- (.+)$/gm, '<li>$1</li>').replace(/\\n/g, '<br>');\nhtml = html.replace(/(<li>.*?<\\/li>(<br>)?)+/g, match => '<ul>' + match.replace(/<br>/g, '') + '</ul>');\nreturn [{ json: { html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2688, 0],
      "id": "format-html",
      "name": "🎨 Оформить HTML",
      "notesInFlow": true,
      "notes": "Готовит результат к email-доставке"
    },
    {
      "parameters": {
        "sendTo": "recipient@example.com",
        "subject": "SEO Audit Report",
        "message": "=<div style=\"font-family:Arial,sans-serif;line-height:1.6\">{{ $('🎨 Оформить HTML').item.json.html }}</div>",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [2912, 0],
      "id": "email-report",
      "name": "✉️ Отправить на email",
      "notesInFlow": true,
      "notes": "Доставляет итоговый отчёт"
    }
  ],
